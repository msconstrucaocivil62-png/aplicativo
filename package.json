{
  "name": "o-profissional-certo",
  "private": true,
  "version": "5.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "check": "npm run lint && npm run build",
    "start:prod": "cross-env NODE_ENV=production node dist/server.cjs",
    "android:prepare": "npm run build && npx cap sync android",
    "android:open": "npx cap open android"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "esbuild": "^0.25.0",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "mercadopago": "^3.2.1",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "cross-env": "^7.0.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0"
  },
  "description": "O Profissional Certo - marketplace de serviços com clientes, profissionais, propostas, chat, agenda e administração.",
  "optionalDependencies": {
    "@capacitor/android": "^7.4.2",
    "@capacitor/cli": "^7.4.2",
    "@capacitor/core": "^7.4.2"
  }
}
